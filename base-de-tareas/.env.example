NODE_ENV=development
PORT=3000

# Local: file:./database/local.db
# Turso: libsql://tu-base-tu-organizacion.turso.io
TURSO_DATABASE_URL=file:./database/local.db
TURSO_AUTH_TOKEN=

# Genera un secreto largo y aleatorio (mínimo 32 caracteres).
JWT_SECRET=

# URL pública de la aplicación, sin diagonal final.
APP_URL=http://localhost:3000

# Recordatorios por correo (Resend).
RESEND_API_KEY=
EMAIL_FROM=Base de Tareas <recordatorios@tu-dominio.com>
