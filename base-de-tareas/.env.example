NODE_ENV=development
PORT=3000

# Local: file:./database/local.db
# Turso: libsql://tu-base-tu-organizacion.turso.io
TURSO_DATABASE_URL=file:./database/local.db
TURSO_AUTH_TOKEN=

# Genera un secreto largo y aleatorio (mínimo 32 caracteres).
JWT_SECRET=

# URL pública de la aplicación, sin diagonal final.
APP_URL=http://localhost:3000

# Recordatorios por correo (Resend).
RESEND_API_KEY=
EMAIL_FROM=Base de Tareas <recordatorios@tu-dominio.com>
# Mientras uses onboarding@resend.dev, redirige las pruebas al correo de tu cuenta Resend.
EMAIL_RECIPIENT_OVERRIDE=

# Vercel lo envía como Bearer token al ejecutar el cron diario.
CRON_SECRET=

# Notificaciones push para la PWA instalada (iPhone y Android).
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Debe ser una URL HTTPS o un correo con formato mailto:.
VAPID_SUBJECT=https://tu-dominio.com

# Programación exacta de notificaciones push personales con Upstash QStash.
# Usa https://qstash-us-east-1.upstash.io cuando las credenciales sean de la región US.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
