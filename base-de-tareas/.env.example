# Base de Tareas - Configuración de Variables de Entorno

# Configuración de Turso (LibSQL Database)
# Obtén estos valores creando una base de datos gratuita en https://turso.tech
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu_token_de_autenticacion_turso

# Clave Secreta para JWT (JSON Web Tokens)
JWT_SECRET=super_secreto_base_de_tareas_jwt_token_2026

# Puerto del Servidor Local (Opcional, por defecto 3000)
PORT=3000
