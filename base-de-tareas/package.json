{
  "name": "base-de-tareas",
  "version": "2.5.0",
  "private": true,
  "description": "Organizador escolar colaborativo para Vercel y Turso",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "migrate": "node scripts/migrate.mjs",
    "check": "npm run check:syntax && npm run test",
    "check:syntax": "find api src public scripts -name '*.js' -o -name '*.mjs' | xargs -n1 node --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "^6.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "fetch-cookie": "^3.2.0",
    "happy-dom": "^20.14.5",
    "html-validate": "^11.16.0",
    "supertest": "^7.1.4",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
