{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "database/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 14 * * *" }
  ]
}
